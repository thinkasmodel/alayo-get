    "@types/node": "^24.19.1",
    "@types/turndown": "5.0.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wxt": "0.21.4",
    "yaml": "2.9.1"
